# Marinara Engine — Docker Compose
# ──────────────────────────────────────────────
services:
  marinara:
    build:
      context: .
      dockerfile: Dockerfile
    image: marinara-engine-local
    init: true

    extra_hosts:
      - "host.docker.internal:host-gateway"

    ports:
      - "0.0.0.0:${PORT:-7860}:7860"

    volumes:
      - marinara-data:/app/data
      - ./certs:/app/certs:ro

    environment:
      - NODE_ENV=production
      - DATA_DIR=/app/data
      - FILE_STORAGE_DIR=/app/data/storage
      - MARINARA_DOCKER=true

      - AUTO_CREATE_DEFAULT_CONNECTION=${AUTO_CREATE_DEFAULT_CONNECTION:-true}
      - TRUSTED_HOSTS=${TRUSTED_HOSTS:-}
      - CORS_ORIGINS=${CORS_ORIGINS:-}
      - CSRF_TRUSTED_ORIGINS=${CSRF_TRUSTED_ORIGINS:-}

      - PROVIDER_LOCAL_URLS_ENABLED=true
      - ENABLE_EXTERNAL_EXTENSIONS=${ENABLE_EXTERNAL_EXTENSIONS:-false}

      # Privileged API access
      - ADMIN_SECRET=${ADMIN_SECRET:-}

      # HTTPS / TLS
      - SSL_CERT=${SSL_CERT:-/app/certs/marinara-cert.pem}
      - SSL_KEY=${SSL_KEY:-/app/certs/marinara-key.pem}

      - IP_ALLOWLIST=${IP_ALLOWLIST:-}

      # Set BASIC_AUTH_USER/BASIC_AUTH_PASS and ADMIN_SECRET before exposing beyond localhost.
      # - TZ=America/New_York
      # - ENCRYPTION_KEY=
      # - LOG_LEVEL=debug

    restart: unless-stopped

volumes:
  marinara-data:
